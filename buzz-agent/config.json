{
  "name": "Buzz Agent",
  "version": "0.1.4",
  "slug": "buzz_agent",
  "description": "Runs a Buzz AI agent that stays online on Home Assistant, connected to your Buzz relay",
  "url": "https://github.com/block/buzz",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "init": false,
  "startup": "application",
  "boot": "auto",
  "backup": "cold",
  "stage": "experimental",
  "options": {
    "relay_url": "",
    "owner_pubkey": "",
    "display_name": "Buzz Agent",
    "about": "",
    "avatar_url": "",
    "provider": "openrouter",
    "api_key": "",
    "model": "anthropic/claude-sonnet-4.5",
    "api_base_url": "",
    "respond_to": "owner-only",
    "respond_to_allowlist": "",
    "join_channels": "",
    "channels": "",
    "subscribe": "mentions",
    "require_mention": true,
    "mcp_command": "buzz-dev-mcp",
    "system_prompt": "",
    "log_level": "info"
  },
  "schema": {
    "relay_url": "match(^wss?://[A-Za-z0-9._:\\[\\]-]+$)",
    "owner_pubkey": "match(^(npub1[023456789acdefghjklmnpqrstuvwxyz]{58}|[0-9a-fA-F]{64})$)",
    "display_name": "str?",
    "about": "str?",
    "avatar_url": "str?",
    "provider": "list(openrouter|anthropic|openai|databricks)",
    "api_key": "password",
    "model": "str",
    "api_base_url": "str?",
    "respond_to": "list(owner-only|anyone|allowlist)?",
    "respond_to_allowlist": "str?",
    "join_channels": "str?",
    "channels": "str?",
    "subscribe": "list(mentions|all)?",
    "require_mention": "bool?",
    "mcp_command": "str?",
    "system_prompt": "str?",
    "log_level": "list(trace|debug|info|warn|error)?"
  }
}
